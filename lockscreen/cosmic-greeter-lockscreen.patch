+// Animated lock screen background: the driftpaper wallpaper image with
+// drifting, twinkling sparks drawn on top. Reads ~/.config/driftpaper/config.ini
+// so the lock screen matches the desktop.
+
+use cosmic::iced::widget::canvas::{self, Frame, Geometry, Path};
+use cosmic::iced::{Color, Point, Rectangle, Vector, mouse};
+use std::path::PathBuf;
+
+/// The animation pauses after this long without keyboard or pointer input.
+pub const PAUSE_AFTER: std::time::Duration = std::time::Duration::from_secs(5 * 60);
+
+/// Frame rate of the animation; halved on battery to save power.
+pub fn fps(on_battery: bool) -> u64 {
+    if on_battery { 30 } else { 60 }
+}
+
+pub struct Config {
+    pub image: Option<PathBuf>,
+    pub colors: Vec<Color>,
+    pub count: usize,
+    pub white: f32,
+}
+
+impl Default for Config {
+    fn default() -> Self {
+        Self {
+            image: None,
+            colors: vec![
+                Color::from_rgb8(0xff, 0x7a, 0x2e),
+                Color::from_rgb8(0xff, 0xb3, 0x47),
+                Color::from_rgb8(0xff, 0x4d, 0x2e),
+            ],
+            count: 90,
+            white: 0.1,
+        }
+    }
+}
+
+fn parse_color(s: &str) -> Option<Color> {
+    let h = s.trim().trim_start_matches('#');
+    if h.len() != 6 {
+        return None;
+    }
+    let v = u32::from_str_radix(h, 16).ok()?;
+    Some(Color::from_rgb8((v >> 16) as u8, (v >> 8) as u8, v as u8))
+}
+
+pub fn load_config() -> Config {
+    let mut cfg = Config::default();
+    let Some(path) = dirs::config_dir().map(|d| d.join("driftpaper/config.ini")) else {
+        return cfg;
+    };
+    let Ok(text) = std::fs::read_to_string(path) else {
+        return cfg;
+    };
+    let mut section = String::new();
+    for line in text.lines() {
+        let line = line.trim();
+        if line.starts_with('[') {
+            section = line.trim_matches(|c| c == '[' || c == ']').to_string();
+            continue;
+        }
+        let Some((key, value)) = line.split_once('=') else {
+            continue;
+        };
+        let (key, value) = (key.trim(), value.trim());
+        match (section.as_str(), key) {
+            ("general", "image") if !value.is_empty() => {
+                let p = PathBuf::from(value);
+                if p.is_file() {
+                    cfg.image = Some(p);
+                }
+            }
+            ("particles", "colors") => {
+                let colors: Vec<Color> = value.split(',').filter_map(parse_color).collect();
+                if !colors.is_empty() {
+                    cfg.colors = colors;
+                }
+            }
+            // Keep the lock screen lighter than the wallpaper itself.
+            ("particles", "count") => {
+                if let Ok(n) = value.parse::<usize>() {
+                    cfg.count = (n / 2).clamp(20, 120);
+                }
+            }
+            ("particles", "white") => {
+                if let Ok(w) = value.parse::<f32>() {
+                    cfg.white = w.clamp(0.0, 1.0);
+                }
+            }
+            _ => {}
+        }
+    }
+    cfg
+}
+
+#[derive(Clone, Copy, Debug)]
+struct Particle {
+    x: f32,
+    y: f32,
+    speed: f32,
+    size: f32,
+    sway: f32,
+    phase: f32,
+    twinkle: f32,
+    spark: bool,
+    color: Color,
+}
+
+pub struct Field {
+    particles: Vec<Particle>,
+}
+
+impl Field {
+    pub fn new(cfg: &Config) -> Self {
+        // Small deterministic LCG; no need for a rand dependency.
+        let mut seed: u32 = 42;
+        let mut rnd = move || {
+            seed = seed.wrapping_mul(1_664_525).wrapping_add(1_013_904_223);
+            (seed >> 8) as f32 / (1u32 << 24) as f32
+        };
+        let particles = (0..cfg.count)
+            .map(|_| {
+                let color = if rnd() < cfg.white {
+                    Color::WHITE
+                } else {
+                    cfg.colors[(rnd() * cfg.colors.len() as f32) as usize % cfg.colors.len()]
+                };
+                Particle {
+                    x: rnd(),
+                    y: rnd(),
+                    speed: 0.012 + rnd() * 0.03,
+                    size: 1.2 + rnd() * 2.6,
+                    sway: 6.0 + rnd() * 22.0,
+                    phase: rnd() * std::f32::consts::TAU,
+                    twinkle: 0.6 + rnd() * 1.6,
+                    spark: rnd() < 0.3,
+                    color,
+                }
+            })
+            .collect();
+        Self { particles }
+    }
+
+    pub fn at(&self, t: f32) -> Scene<'_> {
+        Scene { field: self, t }
+    }
+}
+
+/// One frame of the [`Field`] at time `t` (seconds).
+pub struct Scene<'a> {
+    field: &'a Field,
+    t: f32,
+}
+
+impl<Message> canvas::Program<Message, cosmic::Theme> for Scene<'_> {
+    type State = ();
+
+    fn draw(
+        &self,
+        _state: &(),
+        renderer: &cosmic::Renderer,
+        _theme: &cosmic::Theme,
+        bounds: Rectangle,
+        _cursor: mouse::Cursor,
+    ) -> Vec<Geometry> {
+        let mut frame = Frame::new(renderer, bounds.size());
+        let (w, h) = (bounds.width, bounds.height);
+        let scale = (h / 1440.0).max(0.5);
+        let t = self.t;
+        for p in &self.field.particles {
+            // Rise from the bottom and wrap, with a gentle sideways sway.
+            let margin = 0.05;
+            let y = (p.y - t * p.speed).rem_euclid(1.0 + 2.0 * margin) - margin;
+            let x = p.x * w + (t * 0.35 + p.phase).sin() * p.sway * scale;
+            let center = Point::new(x, y * h);
+            // Fade in near the bottom and out near the top.
+            let edge = (y.clamp(0.0, 1.0) * (1.0 - y.clamp(0.0, 1.0)) * 6.0).min(1.0);
+            let tw = 0.55 + 0.45 * (t * p.twinkle + p.phase).sin();
+            let alpha = edge * tw;
+            if alpha <= 0.02 {
+                continue;
+            }
+            let r = p.size * scale;
+
+            frame.fill(
+                &Path::circle(center, r * 3.2),
+                Color { a: 0.07 * alpha, ..p.color },
+            );
+            frame.fill(
+                &Path::circle(center, r * 1.6),
+                Color { a: 0.18 * alpha, ..p.color },
+            );
+            if p.spark {
+                // Four-point sparkle.
+                let l = r * 3.0;
+                let k = r * 0.35;
+                let path = Path::new(|b| {
+                    b.move_to(center + Vector::new(0.0, -l));
+                    b.line_to(center + Vector::new(k, -k));
+                    b.line_to(center + Vector::new(l, 0.0));
+                    b.line_to(center + Vector::new(k, k));
+                    b.line_to(center + Vector::new(0.0, l));
+                    b.line_to(center + Vector::new(-k, k));
+                    b.line_to(center + Vector::new(-l, 0.0));
+                    b.line_to(center + Vector::new(-k, -k));
+                    b.close();
+                });
+                frame.fill(&path, Color { a: 0.9 * alpha, ..p.color });
+            }
+            frame.fill(
+                &Path::circle(center, r * 0.55),
+                Color {
+                    a: alpha,
+                    ..Color::from_rgb(
+                        p.color.r * 0.5 + 0.5,
+                        p.color.g * 0.5 + 0.5,
+                        p.color.b * 0.5 + 0.5,
+                    )
+                },
+            );
+        }
+        vec![frame.into_geometry()]
+    }
+}
