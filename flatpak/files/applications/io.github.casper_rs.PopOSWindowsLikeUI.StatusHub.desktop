[Desktop Entry]
Type=Application
Terminal=false
NoDisplay=true
Categories=COSMIC;
X-CosmicApplet=true
Name=Status Hub
Comment=Application tray items, gathered behind a single panel button
Exec=wlui-statushub
Icon=io.github.marcelogomes90.cosmic-ext-applet-status-hub-symbolic
X-CosmicShrinkable=true
X-HostWaylandDisplay=true
X-CosmicHoverPopup=Auto
X-OverflowPriority=90
X-OverflowMinSize=1
