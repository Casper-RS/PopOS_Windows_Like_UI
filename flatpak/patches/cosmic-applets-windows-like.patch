+/// Accent-colored square tile with the app icon centered and its name in the
+/// bottom-left corner, like Windows 10 Start tiles.
+fn tile(app: &cosmic::desktop::DesktopEntryData, pinned: bool, index: usize) -> Element<'_, Message> {
+    use cosmic::desktop::IconSourceExt;
+    fn style(theme: &cosmic::Theme, hovered: bool, pressed: bool) -> button::Style {
+        let cosmic = theme.cosmic();
+        let mut bg: iced::Color = cosmic.accent_color().into();
+        bg.a = if pressed { 0.65 } else if hovered { 0.95 } else { 0.8 };
+        let mut s = button::Style::new();
+        s.background = Some(iced::Background::Color(bg));
+        s.border_radius = cosmic.corner_radii.radius_s.into();
+        s.text_color = Some(cosmic.on_accent_color().into());
+        s.icon_color = s.text_color;
+        if hovered {
+            s.border_width = 2.0;
+            s.border_color = cosmic.on_accent_color().into();
+        }
+        s
+    }
+    let pin: Element<'_, Message> = if pinned {
+        text_icon("pin-symbolic", 12).into()
+    } else {
+        Space::new().into()
+    };
+    let tile = button::custom(
+        column![
+            row![space::horizontal().width(Length::Fill), pin],
+            widget::container(icon(app.icon.as_cosmic_icon()).size(40))
+                .center_x(Length::Fill)
+                .center_y(Length::Fill),
+            text::caption(app.name.as_str())
+                .ellipsize(cosmic::iced::advanced::text::Ellipsize::End(
+                    cosmic::iced::advanced::text::EllipsizeHeightLimit::Lines(1),
+                )),
+        ]
+        .padding(8),
+    )
+    .width(Length::Fixed(TILE))
+    .height(Length::Fixed(TILE))
+    .padding(0)
+    .class(theme::Button::Custom {
+        active: Box::new(|_, t| style(t, false, false)),
+        disabled: Box::new(|t| style(t, false, false)),
+        hovered: Box::new(|_, t| style(t, true, false)),
+        pressed: Box::new(|_, t| style(t, true, true)),
+    })
+    .on_press(Message::LaunchTile(index));
+    cosmic::widget::mouse_area(tile)
+        .on_right_press(Message::TogglePin(index))
+        .into()
+}
+
