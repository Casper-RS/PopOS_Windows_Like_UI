+fn shortcut_label<'a>(keys: &[&'static str]) -> Element<'a, Message> {
+    fn pane<'a>() -> Element<'a, Message> {
+        widget::container(Space::new().width(Length::Fixed(6.0)).height(Length::Fixed(6.0)))
+            .class(theme::Container::custom(|theme| widget::container::Style {
+                background: Some(iced::Background::Color(
+                    theme.cosmic().background(theme.transparent).on.into(),
+                )),
+                ..Default::default()
+            }))
+            .into()
+    }
+    let mut r = row![].spacing(4).align_y(Alignment::Center);
+    for (i, key) in keys.iter().enumerate() {
+        if i > 0 {
+            r = r.push(text::body("+"));
+        }
+        r = r.push(match *key {
+            "win" => Element::from(
+                column![
+                    row![pane(), pane()].spacing(1),
+                    row![pane(), pane()].spacing(1),
+                ]
+                .spacing(1),
+            ),
+            // Outlined shift arrow, same height as the logo.
+            "shift" => icon::from_svg_bytes(SHIFT_SVG)
+                .symbolic(true)
+                .icon()
+                .size(14)
+                .into(),
+            k => text::body(k).into(),
+        });
+    }
+    r.into()
+}
