+    ("date-time", "Date & Time", "clock timezone"),
+    ("region-language", "Region & Language", "language locale formats"),
+    ("users", "Users", "accounts password login"),
+    ("about", "About", "system device name version hardware"),
+    ("default-apps", "Default Apps", "browser mail open with"),
+    ("startup-apps", "Startup Apps", "autostart login"),
+    ("accessibility", "Accessibility", "a11y screen reader contrast zoom"),
+    ("accessibility-magnifier", "Magnifier", "zoom"),
+];
+
+#[derive(Debug, Clone)]
+pub enum SearchMsg {
+    Insert(String),
+    Backspace,
+    BackspaceWord,
+    Submit,
+    Open(usize),
+    LaunchRecent(String),
+    TogglePin(String),
+    Move(i32),
+    OpenLauncher,
+}
+
+/// What the popup asks the applet to do after handling a message.
+pub enum Outcome {
+    None,
+    Launch(DesktopEntryData),
+    OpenSetting(&'static str),
+    OpenFolder(PathBuf),
+    OpenLauncher,
+    /// Scroll the list so this share of it (0 = top, 1 = bottom) is in view.
+    ScrollTo(f32),
+}
+
+#[derive(Debug, Clone, PartialEq)]
+enum Hit {
+    App(usize),
+    Setting(usize),
+    Folder(PathBuf),
+}
+
+#[derive(Default)]
+pub struct Search {
+    pub query: String,
+    apps: Vec<DesktopEntryData>,
+    folders: Vec<PathBuf>,
+    // Grouped as apps, then settings, then folders; arrow keys walk the list.
+    results: Vec<Hit>,
+    selected: usize,
+    recent_apps: Vec<String>,
+    // Apps pinned to the Start menu (shared file with the Start applet).
+    pinned: Vec<String>,
+}
+
+impl Search {
+    /// Load installed apps and the recent history; called when the popup opens.
+    pub fn open(&mut self) {
+        let locales = get_languages_from_env();
+        let desktop = std::env::var("XDG_CURRENT_DESKTOP").ok();
+        self.apps = cosmic::desktop::load_applications(&locales, false, desktop.as_deref())
+            .filter(|app| app.exec.is_some())
+            .collect();
+        self.apps.sort_by_key(|app| app.name.to_lowercase());
+        self.folders = scan_folders();
+        self.query.clear();
+        self.selected = 0;
+        self.results.clear();
+        self.load_history();
+        self.pinned = read_pinned();
+    }
+
+    pub fn update(&mut self, msg: SearchMsg) -> Outcome {
+        match msg {
+            SearchMsg::Insert(t) => {
+                // Pasted text may span lines; keep the query on one line.
+                self.query.extend(t.chars().filter(|c| !c.is_control()));
+                self.refresh();
+                return Outcome::ScrollTo(0.0);
+            }
+            SearchMsg::Backspace => {
+                self.query.pop();
+                self.refresh();
+                return Outcome::ScrollTo(0.0);
+            }
+            SearchMsg::BackspaceWord => {
+                let kept = self.query.trim_end().len();
+                let start = self.query[..kept]
+                    .rfind(char::is_whitespace)
+                    .map_or(0, |i| i + 1);
+                self.query.truncate(start);
+                self.refresh();
+                return Outcome::ScrollTo(0.0);
+            }
+            SearchMsg::Move(delta) => {
+                let len = self.visible_len();
+                if len > 0 {
+                    self.selected =
+                        (self.selected as i32 + delta).rem_euclid(len as i32) as usize;
+                    return Outcome::ScrollTo(self.selected as f32 / (len.max(2) - 1) as f32);
+                }
+            }
+            SearchMsg::Submit => {
+                if self.query.trim().is_empty() {
+                    if let Some(id) = self.recent_apps.get(self.selected).cloned() {
+                        return self.launch_id(&id);
+                    }
+                    return Outcome::None;
+                }
+                return match self.results.get(self.selected) {
+                    Some(_) => self.open_hit(self.selected),
+                    None => Outcome::OpenLauncher,
+                };
+            }
+            SearchMsg::Open(n) => return self.open_hit(n),
+            SearchMsg::LaunchRecent(id) => return self.launch_id(&id),
+            SearchMsg::TogglePin(id) => {
+                if self.pinned.contains(&id) {
+                    self.pinned.retain(|p| p != &id);
+                } else {
+                    self.pinned.push(id);
+                }
+                write_pinned(&self.pinned);
+            }
+            SearchMsg::OpenLauncher => return Outcome::OpenLauncher,
+        }
+        Outcome::None
+    }
+
+    fn visible_len(&self) -> usize {
+        if self.query.trim().is_empty() {
+            self.recent_apps.len()
+        } else {
+            self.results.len()
+        }
+    }
+
+    fn refresh(&mut self) {
+        self.selected = 0;
+        self.results.clear();
+        let q = self.query.trim().to_lowercase();
+        if q.is_empty() {
+            return;
+        }
+
+        let mut apps: Vec<(u8, usize)> = self
+            .apps
+            .iter()
+            .enumerate()
+            .filter_map(|(i, app)| {
+                let score = name_score(&app.name, &q).or_else(|| {
+                    (app.id.to_lowercase().contains(&q)
+                        || app.exec.as_deref().is_some_and(|e| e.to_lowercase().contains(&q))
+                        || app.categories.iter().any(|c| c.to_lowercase().contains(&q)))
+                    .then_some(3)
+                })?;
+                Some((score, i))
+            })
+            .collect();
+        apps.sort_by_key(|&(score, i)| (score, self.apps[i].name.len()));
+
+        let mut settings: Vec<(u8, usize)> = SETTINGS
+            .iter()
+            .enumerate()
+            .filter_map(|(i, &(_, title, keywords))| {
+                let keyword = q.len() >= 2 && keywords.split_whitespace().any(|w| w.starts_with(&q));
+                Some((name_score(title, &q).or(keyword.then_some(3))?, i))
+            })
+            .collect();
+        settings.sort_by_key(|&(score, i)| (score, SETTINGS[i].1.len()));
+
+        let mut folders: Vec<(u8, &PathBuf)> = self
+            .folders
+            .iter()
+            .filter_map(|path| Some((name_score(&folder_name(path), &q)?, path)))
+            .collect();
+        // Shallow folders first: ~/Documents beats ~/x/y/Documents.
+        folders.sort_by_key(|&(score, path)| (score, path.components().count()));
+
+        let mut groups: [Vec<Hit>; 3] = [
+            apps.into_iter().map(|(_, i)| Hit::App(i)).collect(),
+            settings.into_iter().map(|(_, i)| Hit::Setting(i)).collect(),
+            folders.into_iter().map(|(_, path)| Hit::Folder(path.clone())).collect(),
+        ];
+        let mut counts = [MAX_APPS, MAX_SETTINGS, MAX_FOLDERS];
+        for (count, group) in counts.iter_mut().zip(&groups) {
+            *count = (*count).min(group.len());
+        }
+        let mut spare = MAX_RESULTS - counts.iter().sum::<usize>();
+        for (count, group) in counts.iter_mut().zip(&groups) {
+            let extra = spare.min(group.len() - *count);
+            *count += extra;
+            spare -= extra;
+        }
+        for (count, group) in counts.into_iter().zip(&mut groups) {
+            self.results.extend(group.drain(..count));
+        }
+    }
+
+    fn open_hit(&mut self, n: usize) -> Outcome {
+        match self.results.get(n).cloned() {
+            Some(Hit::App(i)) => self.launch(i),
+            Some(Hit::Setting(i)) => Outcome::OpenSetting(SETTINGS[i].0),
+            Some(Hit::Folder(path)) => Outcome::OpenFolder(path),
+            None => Outcome::None,
+        }
+    }
+
+    fn launch(&mut self, i: usize) -> Outcome {
+        let Some(app) = self.apps.get(i).cloned() else {
+            return Outcome::None;
+        };
+        self.remember(&app.id);
+        Outcome::Launch(app)
+    }
+
+    fn launch_id(&mut self, id: &str) -> Outcome {
+        match self.apps.iter().position(|a| a.id == id) {
+            Some(i) => self.launch(i),
+            None => Outcome::None,
+        }
+    }
+
+    fn remember(&mut self, app_id: &str) {
+        self.recent_apps.retain(|id| id != app_id);
+        self.recent_apps.insert(0, app_id.to_string());
+        self.recent_apps.truncate(MAX_RECENT_APPS);
+        self.save_history();
+    }
+
+    fn history_path() -> Option<PathBuf> {
+        let base = std::env::var_os("XDG_STATE_HOME")
+            .map(PathBuf::from)
+            .or_else(|| std::env::var_os("HOME").map(|h| PathBuf::from(h).join(".local/state")))?;
+        Some(base.join("windows-like-search/history"))
+    }
+
+    fn load_history(&mut self) {
+        self.recent_apps.clear();
+        let Some(text) = Self::history_path().and_then(|p| fs::read_to_string(p).ok()) else {
+            return;
+        };
+        for line in text.lines() {
+            if let Some(id) = line.strip_prefix("app:") {
+                if self.apps.iter().any(|a| a.id == id) {
+                    self.recent_apps.push(id.to_string());
+                }
+            }
+        }
+        self.recent_apps.truncate(MAX_RECENT_APPS);
+    }
+
+    fn save_history(&self) {
+        let Some(path) = Self::history_path() else {
+            return;
+        };
+        let mut out = String::new();
+        for id in &self.recent_apps {
+            out.push_str(&format!("app:{id}\n"));
+        }
+        if let Some(dir) = path.parent() {
+            let _ = fs::create_dir_all(dir);
+        }
+        let _ = fs::write(path, out);
+    }
+
+    pub fn view(&self) -> Element<'_, SearchMsg> {
+        let spacing = theme::active().cosmic().spacing;
+        let mut list = column::with_capacity(16).spacing(2);
+
+        let heading = |label: &'static str| {
+            text::caption_heading(label)
+                .apply_padding([spacing.space_xxs, spacing.space_s])
+        };
+
+        if self.query.trim().is_empty() {
+            if self.recent_apps.is_empty() {
+                list = list.push(heading("Type to search apps, settings and folders"));
+            }
+            if !self.recent_apps.is_empty() {
+                list = list.push(heading("Recent"));
+                for (n, id) in self.recent_apps.iter().enumerate() {
+                    if let Some(app) = self.apps.iter().find(|a| &a.id == id) {
+                        list = list.push(self.pinnable(
+                            app,
+                            app_row(app, n == self.selected, self.pinned.contains(&app.id))
+                                .on_press(SearchMsg::LaunchRecent(id.clone())),
+                        ));
+                    }
+                }
+            }
+        } else if self.results.is_empty() {
+            list = list.push(heading("No results"));
+        } else {
+            let mut group = "";
+            for (n, hit) in self.results.iter().enumerate() {
+                let selected = n == self.selected;
+                let title = match hit {
+                    Hit::App(_) => "Apps",
+                    Hit::Setting(_) => "Settings",
+                    Hit::Folder(_) => "Folders",
+                };
+                if title != group {
+                    group = title;
+                    list = list.push(heading(title));
+                }
+                list = list.push(match hit {
+                    Hit::App(i) => {
+                        let app = &self.apps[*i];
+                        self.pinnable(
+                            app,
+                            app_row(app, selected, self.pinned.contains(&app.id))
+                                .on_press(SearchMsg::Open(n)),
+                        )
+                    }
+                    Hit::Setting(i) => labeled_row(
+                        icon::from_name("preferences-system-symbolic").size(20).into(),
+                        SETTINGS[*i].1.to_string(),
+                        "Settings".to_string(),
+                        selected,
+                    )
+                    .on_press(SearchMsg::Open(n))
+                    .into(),
+                    Hit::Folder(path) => labeled_row(
+                        icon::from_name("folder").size(28).into(),
+                        folder_name(path),
+                        display_path(path),
+                        selected,
+                    )
+                    .on_press(SearchMsg::Open(n))
+                    .into(),
+                });
+            }
+        }
+
+        let mut footer = column::with_capacity(2).spacing(2);
+        footer = footer.push(
+            text::caption("Right-click an app to pin it to Start")
+                .apply_padding([spacing.space_xxs, spacing.space_s]),
+        );
+        footer = footer.push(
+            menu_button(
+                row![
+                    icon::from_name("system-search-symbolic").size(16),
+                    text::body("Search files and more in the launcher"),
+                ]
+                .spacing(spacing.space_s)
+                .align_y(Alignment::Center),
+            )
+            .on_press(SearchMsg::OpenLauncher),
+        );
+
+        let list = widget::container(
+            widget::scrollable(list).id(RESULTS_ID.clone()).height(Length::Shrink),
+        )
+        .max_height(LIST_MAX_HEIGHT);
+        column![list, footer]
+            .spacing(spacing.space_xxs)
+            .padding([spacing.space_xs, 0])
+            .width(Length::Fixed(440.0))
+            .into()
+    }
+}
+
+impl Search {
+    /// Right-click pins the app to Start, or unpins it.
+    fn pinnable<'a>(
+        &self,
+        app: &DesktopEntryData,
+        row: widget::Button<'a, SearchMsg>,
+    ) -> Element<'a, SearchMsg> {
+        widget::mouse_area(row)
+            .on_right_press(SearchMsg::TogglePin(app.id.clone()))
+            .into()
+    }
+}
+
+fn pinned_path() -> Option<PathBuf> {
+    let base = std::env::var_os("XDG_STATE_HOME")
+        .map(PathBuf::from)
+        .or_else(|| std::env::var_os("HOME").map(|h| PathBuf::from(h).join(".local/state")))?;
+    Some(base.join("windows-like-ui/start-pinned"))
+}
+
+fn read_pinned() -> Vec<String> {
+    pinned_path()
+        .and_then(|p| fs::read_to_string(p).ok())
+        .map(|t| t.lines().filter(|l| !l.is_empty()).map(str::to_string).collect())
+        .unwrap_or_default()
+}
+
+fn write_pinned(pinned: &[String]) {
+    let Some(path) = pinned_path() else {
+        return;
+    };
+    if let Some(dir) = path.parent() {
+        let _ = fs::create_dir_all(dir);
+    }
+    let _ = fs::write(path, pinned.iter().map(|id| format!("{id}\n")).collect::<String>());
+}
+
+/// Rank a name: it starts with the query, a word in it does, or it contains it.
+fn name_score(name: &str, q: &str) -> Option<u8> {
+    let name = name.to_lowercase();
+    if name.starts_with(q) {
+        Some(0)
+    } else if name.split(|c: char| !c.is_alphanumeric()).any(|w| w.starts_with(q)) {
+        Some(1)
+    } else if name.contains(q) {
+        Some(2)
+    } else {
+        None
+    }
+}
+
+fn folder_name(path: &Path) -> String {
+    path.file_name().map_or_else(String::new, |n| n.to_string_lossy().into_owned())
+}
+
+/// Where a folder is, with the home folder written as ~.
+fn display_path(path: &Path) -> String {
+    let parent = path.parent().unwrap_or(path);
+    match std::env::var_os("HOME").map(PathBuf::from) {
+        Some(home) if parent.starts_with(&home) => {
+            let rest = parent.strip_prefix(&home).unwrap_or(parent);
+            if rest.as_os_str().is_empty() {
+                "~".to_string()
+            } else {
+                format!("~/{}", rest.display())
+            }
+        }
+        _ => parent.display().to_string(),
+    }
+}
+
+/// Visible folders in the home folder, a few levels deep.
+fn scan_folders() -> Vec<PathBuf> {
+    let Some(home) = std::env::var_os("HOME").map(PathBuf::from) else {
+        return Vec::new();
+    };
+    let mut found = Vec::new();
+    let mut queue = std::collections::VecDeque::from([(home, 0)]);
+    while let Some((dir, depth)) = queue.pop_front() {
+        let Ok(entries) = fs::read_dir(&dir) else {
+            continue;
+        };
+        for entry in entries.flatten() {
+            let name = entry.file_name();
+            let name = name.to_string_lossy();
+            if name.starts_with('.') || SKIPPED_FOLDERS.contains(&name.as_ref()) {
+                continue;
+            }
+            if !entry.file_type().is_ok_and(|t| t.is_dir()) {
+                continue;
+            }
+            if found.len() >= MAX_SCANNED_FOLDERS {
+                return found;
+            }
+            let path = entry.path();
+            if depth + 1 < FOLDER_DEPTH {
+                queue.push_back((path.clone(), depth + 1));
+            }
+            found.push(path);
+        }
+    }
+    found
+}
+
+/// A settings or folder result: icon, name, and what it is on the right.
+fn labeled_row<'a>(
+    icon: Element<'a, SearchMsg>,
+    name: String,
+    kind: String,
+    selected: bool,
+) -> widget::Button<'a, SearchMsg> {
+    let spacing = theme::active().cosmic().spacing;
+    menu_button(
+        row![
+            widget::container(icon).width(28).center_x(28),
+            text::body(name),
+            widget::space::horizontal().width(Length::Fill),
+            text::caption(kind),
+        ]
+        .spacing(spacing.space_s)
+        .align_y(Alignment::Center),
+    )
+    .class(if selected { highlighted() } else { theme::Button::AppletMenu })
+}
+
+fn app_row(app: &DesktopEntryData, selected: bool, pinned: bool) -> widget::Button<'_, SearchMsg> {
+    let spacing = theme::active().cosmic().spacing;
+    let pin: Element<'_, SearchMsg> = if pinned {
+        icon::from_name("pin-symbolic").size(14).into()
+    } else {
+        widget::Space::new().into()
+    };
+    menu_button(
+        row![
+            icon(app.icon.as_cosmic_icon()).size(28),
+            text::body(app.name.as_str()),
+            widget::space::horizontal().width(Length::Fill),
+            pin,
+        ]
+        .spacing(spacing.space_s)
+        .align_y(Alignment::Center),
+    )
+    .class(if selected { highlighted() } else { theme::Button::AppletMenu })
+}
+
+/// Row picked by the arrow keys (what Enter launches): accent-tinted
+/// background, like the selected result in the Windows search panel.
+fn highlighted() -> theme::Button {
+    fn style(theme: &cosmic::Theme, hovered: bool) -> widget::button::Style {
+        let cosmic = theme.cosmic();
+        let mut bg: cosmic::iced::Color = cosmic.accent_color().into();
+        bg.a = if hovered { 0.3 } else { 0.2 };
+        let mut s = widget::button::Style::new();
+        s.background = Some(cosmic::iced::Background::Color(bg));
+        s.border_radius = cosmic.corner_radii.radius_s.into();
+        s.text_color = Some(cosmic.background(theme.transparent).on.into());
+        s.icon_color = s.text_color;
+        s
+    }
+    theme::Button::Custom {
+        active: Box::new(|_, t| style(t, false)),
+        disabled: Box::new(|t| style(t, false)),
+        hovered: Box::new(|_, t| style(t, true)),
+        pressed: Box::new(|_, t| style(t, true)),
+    }
+}
+
+trait ApplyPadding<'a> {
+    fn apply_padding(self, padding: [u16; 2]) -> Element<'a, SearchMsg>;
+}
+
+impl<'a, T: Into<Element<'a, SearchMsg>>> ApplyPadding<'a> for T {
+    fn apply_padding(self, padding: [u16; 2]) -> Element<'a, SearchMsg> {
+        widget::container(self).padding(padding).into()
+    }
+}
