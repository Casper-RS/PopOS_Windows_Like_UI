+fn hover_popup_settings(
+    app: &CosmicAppList,
+    popup_type: &PopupType,
+    parent_window_id: window::Id,
+    new_id: window::Id,
+    rectangle: iced::Rectangle,
+) -> cosmic::iced::runtime::platform_specific::wayland::popup::SctkPopupSettings {
+    let mut settings = toplevel_list_popup_settings(app, parent_window_id, new_id, rectangle);
+    // Hover popups never grab: no input serial, and no focus stealing.
+    settings.grab = false;
+    if *popup_type == PopupType::Tooltip {
+        settings.positioner.size_limits = Limits::NONE
+            .min_width(1.0)
+            .min_height(1.0)
+            .max_width(400.0)
+            .max_height(100.0);
+    }
+    settings
+}
