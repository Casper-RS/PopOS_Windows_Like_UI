+/// Count a launch for the Start menu's "Most used" tiles (shared with the
+/// Start and search applets; "<count>\t<desktop id>" per line).
+fn record_launch(app_id: &str) {
+    use std::{collections::HashMap, fs, path::PathBuf};
+    let Some(path) = std::env::var_os("XDG_STATE_HOME")
+        .map(PathBuf::from)
+        .or_else(|| std::env::var_os("HOME").map(|h| PathBuf::from(h).join(".local/state")))
+        .map(|d| d.join("windows-like-ui/app-usage"))
+    else {
+        return;
+    };
+    let mut usage: HashMap<String, u32> = fs::read_to_string(&path)
+        .unwrap_or_default()
+        .lines()
+        .filter_map(|l| {
+            let (n, id) = l.split_once('\t')?;
+            Some((id.to_string(), n.parse().ok()?))
+        })
+        .collect();
+    *usage.entry(app_id.to_string()).or_default() += 1;
+    let out: String = usage.iter().map(|(id, n)| format!("{n}\t{id}\n")).collect();
+    if let Some(dir) = path.parent() {
+        let _ = fs::create_dir_all(dir);
+    }
+    let _ = fs::write(path, out);
+}
