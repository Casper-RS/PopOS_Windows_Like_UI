+fn with_alpha(mut c: cosmic::iced::Color, alpha: f32) -> cosmic::iced::Color {
+    c.a *= alpha;
+    c
+}
+
+/// Same look as `applet.popup_container`, but with a fading background.
+fn fading_popup_container<'a>(
+    applet: &cosmic::applet::Context,
+    content: impl Into<Element<'a, Message>>,
+    alpha: f32,
+) -> cosmic::widget::autosize::Autosize<'a, Message, cosmic::Theme, cosmic::Renderer> {
+    use cosmic::iced::alignment::{Horizontal, Vertical};
+    static AUTOSIZE_ID: std::sync::LazyLock<cosmic::widget::Id> =
+        std::sync::LazyLock::new(|| cosmic::widget::Id::new("cosmic-applet-autosize"));
+    let (vertical_align, horizontal_align) = match applet.anchor {
+        PanelAnchor::Left => (Vertical::Center, Horizontal::Left),
+        PanelAnchor::Right => (Vertical::Center, Horizontal::Right),
+        PanelAnchor::Top => (Vertical::Top, Horizontal::Center),
+        PanelAnchor::Bottom => (Vertical::Bottom, Horizontal::Center),
+    };
+    cosmic::widget::autosize::autosize(
+        container(container(content).class(Container::custom(move |theme| {
+            let cosmic = theme.cosmic();
+            let bg = cosmic.background(theme.transparent);
+            container::Style {
+                text_color: Some(with_alpha(bg.on.into(), alpha)),
+                icon_color: Some(with_alpha(bg.on.into(), alpha)),
+                background: Some(Background::Color(with_alpha(bg.base.into(), alpha))),
+                border: Border {
+                    radius: cosmic.corner_radii.radius_m.into(),
+                    width: 1.0,
+                    color: with_alpha(bg.divider.into(), alpha),
+                },
+                ..Default::default()
+            }
+        })))
+        .height(Length::Shrink)
+        .align_x(horizontal_align)
+        .align_y(vertical_align),
+        AUTOSIZE_ID.clone(),
+    )
+}
+
+/// Wrap a desktop Exec line so it runs on the host through `flatpak-spawn`,
+/// forwarding the launch environment (activation token, GPU selection).
+fn host_exec(
+    exec: &str,
+    envs: Vec<(String, String)>,
+    terminal: bool,
+) -> (String, Vec<(String, String)>, bool) {
+    let exec = if terminal {
+        format!("cosmic-term -e {exec}")
+    } else {
+        exec.to_string()
+    };
+    let mut wrapped = String::from("flatpak-spawn --host");
+    for (k, v) in &envs {
+        wrapped.push(' ');
+        // Single-quote for the desktop-exec parser.
+        wrapped.push_str(&format!("'--env={k}={v}'", v = v.replace('\'', "")));
+    }
+    wrapped.push(' ');
+    wrapped.push_str(&exec);
+    (wrapped, Vec::new(), false)
+}
+
+/// Count a launch for the Start menu's "Most used" tiles (shared with the
+/// Start and search applets; "<count>\t<desktop id>" per line).
+fn record_launch(app_id: &str) {
+    use std::{collections::HashMap, fs, path::PathBuf};
+    let Some(path) = std::env::var_os("XDG_STATE_HOME")
+        .map(PathBuf::from)
+        .or_else(|| std::env::var_os("HOME").map(|h| PathBuf::from(h).join(".local/state")))
+        .map(|d| d.join("windows-like-ui/app-usage"))
+    else {
+        return;
+    };
+    let mut usage: HashMap<String, u32> = fs::read_to_string(&path)
+        .unwrap_or_default()
+        .lines()
+        .filter_map(|l| {
+            let (n, id) = l.split_once('\t')?;
+            Some((id.to_string(), n.parse().ok()?))
+        })
+        .collect();
+    *usage.entry(app_id.to_string()).or_default() += 1;
+    let out: String = usage.iter().map(|(id, n)| format!("{n}\t{id}\n")).collect();
+    if let Some(dir) = path.parent() {
+        let _ = fs::create_dir_all(dir);
+    }
+    let _ = fs::write(path, out);
+}
