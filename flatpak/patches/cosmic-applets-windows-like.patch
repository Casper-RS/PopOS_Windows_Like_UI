@@ -0,0 +1,192 @@
+//! Keyboard shortcut for the search box: the shortcut emits a D-Bus signal that
+//! every search box hears, and only the one on the monitor with the focused
+//! window opens.
+
+use std::{
+    os::{
+        fd::{FromRawFd, RawFd},
+        unix::net::UnixStream,
+    },
+    sync::{Arc, Mutex},
+};
+
+use cosmic::{
+    cctk::{
+        self,
+        cosmic_protocols::toplevel_info::v1::client::zcosmic_toplevel_handle_v1::State as ToplevelState,
+        sctk::{
+            self,
+            output::{OutputHandler, OutputState},
+            registry::{ProvidesRegistryState, RegistryState},
+        },
+        toplevel_info::{ToplevelInfoHandler, ToplevelInfoState},
+        wayland_client::{
+            Connection, QueueHandle, globals::registry_queue_init, protocol::wl_output,
+        },
+        wayland_protocols::ext::foreign_toplevel_list::v1::client::ext_foreign_toplevel_handle_v1::ExtForeignToplevelHandleV1,
+    },
+    iced::{
+        Subscription,
+        futures::{SinkExt, StreamExt, channel::mpsc::Sender},
+        stream,
+    },
+};
+
+const INTERFACE: &str = "io.github.casper_rs.PopOSWindowsLikeUI.Search";
+
+/// Fires once per `Open` signal on the session bus.
+pub fn open_requests() -> Subscription<()> {
+    struct OpenRequests;
+    Subscription::run_with(std::any::TypeId::of::<OpenRequests>(), |_| {
+        stream::channel(4, |mut output: Sender<()>| async move {
+            if let Err(err) = listen(&mut output).await {
+                tracing::error!("search shortcut: {err}");
+            }
+            std::future::pending::<()>().await;
+        })
+    })
+}
+
+async fn listen(output: &mut Sender<()>) -> zbus::Result<()> {
+    let conn = zbus::Connection::session().await?;
+    let rule = zbus::MatchRule::builder()
+        .msg_type(zbus::message::Type::Signal)
+        .interface(INTERFACE)?
+        .member("Open")?
+        .build();
+    let mut signals = zbus::MessageStream::for_match_rule(rule, &conn, None).await?;
+    while signals.next().await.is_some() {
+        let _ = output.send(()).await;
+    }
+    Ok(())
+}
+
+#[derive(Default)]
+struct Monitors {
+    /// Monitor of the focused window.
+    focused: Option<String>,
+    /// Top-left monitor, used while no window has focus.
+    first: Option<String>,
+    /// Logical width of each monitor, by name.
+    widths: Vec<(String, i32)>,
+}
+
+/// Knows which monitor the search box should open on.
+#[derive(Clone, Default)]
+pub struct Focus(Arc<Mutex<Monitors>>);
+
+impl Focus {
+    /// Starts tracking in the background; without the panel's privileged
+    /// Wayland socket nothing is tracked and every search box opens.
+    pub fn track() -> Self {
+        let focus = Self::default();
+        let Some(fd) = std::env::var("X_PRIVILEGED_WAYLAND_SOCKET")
+            .ok()
+            .and_then(|fd| fd.parse::<RawFd>().ok())
+        else {
+            return focus;
+        };
+        let monitors = focus.0.clone();
+        std::thread::spawn(move || {
+            let socket = unsafe { UnixStream::from_raw_fd(fd) };
+            if let Err(err) = run(socket, monitors) {
+                tracing::error!("search focus tracking: {err}");
+            }
+        });
+        focus
+    }
+
+    /// Logical width of the named monitor, once known.
+    pub fn screen_width(&self, output: &str) -> Option<i32> {
+        let monitors = self.0.lock().unwrap();
+        monitors.widths.iter().find(|(name, _)| name == output).map(|(_, w)| *w)
+    }
+
+    pub fn opens_on(&self, output: &str) -> bool {
+        let monitors = self.0.lock().unwrap();
+        match monitors.focused.as_ref().or(monitors.first.as_ref()) {
+            Some(target) => target == output,
+            None => true,
+        }
+    }
+}
+
+struct State {
+    registry_state: RegistryState,
+    output_state: OutputState,
+    toplevel_info_state: ToplevelInfoState,
+    monitors: Arc<Mutex<Monitors>>,
+}
+
+impl State {
+    fn output_name(&self, output: &wl_output::WlOutput) -> Option<String> {
+        self.output_state.info(output)?.name
+    }
+
+    fn refresh(&self) {
+        let focused = self
+            .toplevel_info_state
+            .toplevels()
+            .find(|t| t.state.contains(&ToplevelState::Activated))
+            .and_then(|t| t.output.iter().find_map(|o| self.output_name(o)));
+        let first = self
+            .output_state
+            .outputs()
+            .filter_map(|o| self.output_state.info(&o))
+            .min_by_key(|info| info.logical_position.map_or((0, 0), |(x, y)| (y, x)))
+            .and_then(|info| info.name);
+        let widths = self
+            .output_state
+            .outputs()
+            .filter_map(|o| self.output_state.info(&o))
+            .filter_map(|info| Some((info.name?, info.logical_size?.0)))
+            .collect();
+        *self.monitors.lock().unwrap() = Monitors { focused, first, widths };
+    }
+}
+
+fn run(socket: UnixStream, monitors: Arc<Mutex<Monitors>>) -> Result<(), Box<dyn std::error::Error>> {
+    let conn = Connection::from_socket(socket)?;
+    let (globals, mut queue) = registry_queue_init(&conn)?;
+    let qh = queue.handle();
+    let registry_state = RegistryState::new(&globals);
+    let mut state = State {
+        output_state: OutputState::new(&globals, &qh),
+        toplevel_info_state: ToplevelInfoState::new(&registry_state, &qh),
+        registry_state,
+        monitors,
+    };
+    loop {
+        queue.blocking_dispatch(&mut state)?;
+        state.refresh();
+    }
+}
+
+impl ProvidesRegistryState for State {
+    fn registry(&mut self) -> &mut RegistryState {
+        &mut self.registry_state
+    }
+    sctk::registry_handlers!(OutputState);
+}
+
+impl OutputHandler for State {
+    fn output_state(&mut self) -> &mut OutputState {
+        &mut self.output_state
+    }
+    fn new_output(&mut self, _: &Connection, _: &QueueHandle<Self>, _: wl_output::WlOutput) {}
+    fn update_output(&mut self, _: &Connection, _: &QueueHandle<Self>, _: wl_output::WlOutput) {}
+    fn output_destroyed(&mut self, _: &Connection, _: &QueueHandle<Self>, _: wl_output::WlOutput) {}
+}
+
+impl ToplevelInfoHandler for State {
+    fn toplevel_info_state(&mut self) -> &mut ToplevelInfoState {
+        &mut self.toplevel_info_state
+    }
+    fn new_toplevel(&mut self, _: &Connection, _: &QueueHandle<Self>, _: &ExtForeignToplevelHandleV1) {}
+    fn update_toplevel(&mut self, _: &Connection, _: &QueueHandle<Self>, _: &ExtForeignToplevelHandleV1) {}
+    fn toplevel_closed(&mut self, _: &Connection, _: &QueueHandle<Self>, _: &ExtForeignToplevelHandleV1) {}
+}
+
+sctk::delegate_registry!(State);
+sctk::delegate_output!(State);
+cctk::delegate_toplevel_info!(State);
