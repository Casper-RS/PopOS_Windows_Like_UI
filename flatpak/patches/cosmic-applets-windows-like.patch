@@ -0,0 +1,206 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Tiles for the Windows 10 style Start menu.
+//!
+//! Pinned tiles come first (right-click a tile or a search result to pin or
+//! unpin); the remaining slots show the most used apps. COSMIC keeps no app
+//! usage statistics, so launches from the taskbar, the search popup and these
+//! tiles are counted in a small shared file.
+
+use cosmic::desktop::{DesktopEntryData, fde::get_languages_from_env};
+use std::{collections::HashMap, fs, path::PathBuf};
+
+pub const MAX_TILES: usize = 9;
+
+fn state_dir() -> Option<PathBuf> {
+    std::env::var_os("XDG_STATE_HOME")
+        .map(PathBuf::from)
+        .or_else(|| std::env::var_os("HOME").map(|h| PathBuf::from(h).join(".local/state")))
+}
+
+fn usage_path() -> Option<PathBuf> {
+    Some(state_dir()?.join("windows-like-ui/app-usage"))
+}
+
+/// Launch counts per desktop entry id ("<count>\t<id>" per line).
+fn read_usage() -> HashMap<String, u32> {
+    let Some(text) = usage_path().and_then(|p| fs::read_to_string(p).ok()) else {
+        return HashMap::new();
+    };
+    text.lines()
+        .filter_map(|line| {
+            let (count, id) = line.split_once('\t')?;
+            Some((id.to_string(), count.parse().ok()?))
+        })
+        .collect()
+}
+
+pub fn record_launch(app_id: &str) {
+    let Some(path) = usage_path() else {
+        return;
+    };
+    let mut usage = read_usage();
+    *usage.entry(app_id.to_string()).or_default() += 1;
+    let out: String = usage.iter().map(|(id, n)| format!("{n}\t{id}\n")).collect();
+    if let Some(dir) = path.parent() {
+        let _ = fs::create_dir_all(dir);
+    }
+    let _ = fs::write(path, out);
+}
+
+fn pinned_path() -> Option<PathBuf> {
+    Some(state_dir()?.join("windows-like-ui/start-pinned"))
+}
+
+/// Desktop ids pinned to Start, in order.
+pub fn read_pinned() -> Vec<String> {
+    pinned_path()
+        .and_then(|p| fs::read_to_string(p).ok())
+        .map(|t| t.lines().filter(|l| !l.is_empty()).map(str::to_string).collect())
+        .unwrap_or_default()
+}
+
+/// Pin an app to Start, or unpin it if it already is.
+pub fn toggle_pin(app_id: &str) {
+    let Some(path) = pinned_path() else {
+        return;
+    };
+    let mut pinned = read_pinned();
+    if pinned.iter().any(|id| id == app_id) {
+        pinned.retain(|id| id != app_id);
+    } else {
+        pinned.push(app_id.to_string());
+    }
+    if let Some(dir) = path.parent() {
+        let _ = fs::create_dir_all(dir);
+    }
+    let _ = fs::write(path, pinned.iter().map(|id| format!("{id}\n")).collect::<String>());
+}
+
+/// Which tiles Start shows, picked from the dropdown above the grid.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub enum TileView {
+    Pinned,
+    MostUsed,
+}
+
+fn view_path() -> Option<PathBuf> {
+    Some(state_dir()?.join("windows-like-ui/start-view"))
+}
+
+/// Last chosen view; the first time, Pinned if anything is pinned.
+pub fn read_view() -> TileView {
+    match view_path().and_then(|p| fs::read_to_string(p).ok()).as_deref().map(str::trim) {
+        Some("pinned") => TileView::Pinned,
+        Some("most-used") => TileView::MostUsed,
+        _ if !read_pinned().is_empty() => TileView::Pinned,
+        _ => TileView::MostUsed,
+    }
+}
+
+pub fn write_view(view: TileView) {
+    let Some(path) = view_path() else {
+        return;
+    };
+    if let Some(dir) = path.parent() {
+        let _ = fs::create_dir_all(dir);
+    }
+    let name = match view {
+        TileView::Pinned => "pinned",
+        TileView::MostUsed => "most-used",
+    };
+    let _ = fs::write(path, name);
+}
+
+/// Pinned taskbar apps, used to fill the tiles until there is usage data.
+fn taskbar_favorites() -> Vec<String> {
+    let base = std::env::var_os("XDG_CONFIG_HOME")
+        .map(PathBuf::from)
+        .or_else(|| std::env::var_os("HOME").map(|h| PathBuf::from(h).join(".config")));
+    let Some(text) = base.and_then(|b| {
+        fs::read_to_string(b.join("cosmic/com.system76.CosmicAppList/v1/favorites")).ok()
+    }) else {
+        return Vec::new();
+    };
+    text.split('"')
+        .skip(1)
+        .step_by(2)
+        .map(str::to_string)
+        .collect()
+}
+
+/// Start tiles with a "pinned" flag. Pinned view: the pinned apps, in pin
+/// order. Most used view: the most launched apps, topped up with pinned
+/// taskbar apps, up to `MAX_TILES`.
+pub fn tiles(view: TileView) -> Vec<(DesktopEntryData, bool)> {
+    let apps = all_apps();
+    let find = |id: &str| apps.iter().find(|a| a.id == id || a.id == format!("{id}.desktop"));
+
+    let mut usage: Vec<(String, u32)> = read_usage().into_iter().collect();
+    usage.sort_by(|a, b| b.1.cmp(&a.1).then_with(|| a.0.cmp(&b.0)));
+
+    let pinned = read_pinned();
+    let mut tiles: Vec<(DesktopEntryData, bool)> = Vec::new();
+    if view == TileView::Pinned {
+        for id in &pinned {
+            if let Some(app) = find(id)
+                && !tiles.iter().any(|(t, _)| t.id == app.id)
+            {
+                tiles.push((app.clone(), true));
+            }
+        }
+        return tiles;
+    }
+    for id in usage
+        .into_iter()
+        .map(|(id, _)| id)
+        .chain(taskbar_favorites())
+    {
+        if tiles.len() >= MAX_TILES {
+            break;
+        }
+        if let Some(app) = find(&id)
+            && !tiles.iter().any(|(t, _)| t.id == app.id)
+        {
+            tiles.push((app.clone(), pinned.contains(&app.id)));
+        }
+    }
+    tiles
+}
+
+/// Every launchable app, sorted by name (Start's "All apps" list).
+pub fn all_apps() -> Vec<DesktopEntryData> {
+    let locales = get_languages_from_env();
+    let desktop = std::env::var("XDG_CURRENT_DESKTOP").ok();
+    let mut apps: Vec<DesktopEntryData> =
+        cosmic::desktop::load_applications(&locales, false, desktop.as_deref())
+            .filter(|app| app.exec.is_some())
+            .collect();
+    apps.sort_by_key(|app| app.name.to_lowercase());
+    apps
+}
+
+/// Launch an app; inside a Flatpak it runs on the host.
+pub async fn launch(app: DesktopEntryData) {
+    let Some(exec) = app.exec else {
+        return;
+    };
+    record_launch(&app.id);
+    let (exec, terminal) = if std::env::var_os("FLATPAK_ID").is_some() {
+        let exec = if app.terminal {
+            format!("cosmic-term -e {exec}")
+        } else {
+            exec
+        };
+        (format!("flatpak-spawn --host {exec}"), false)
+    } else {
+        (exec, app.terminal)
+    };
+    cosmic::desktop::spawn_desktop_exec(
+        exec,
+        Vec::<(String, String)>::new(),
+        Some(app.id.as_str()),
+        terminal,
+    )
+    .await;
+}
