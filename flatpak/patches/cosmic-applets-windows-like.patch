+/// Launch a search result; inside a Flatpak it runs on the host.
+async fn launch_app(app: cosmic::desktop::DesktopEntryData) {
+    let Some(exec) = app.exec else {
+        return;
+    };
+    record_launch(&app.id);
+    let (exec, terminal) = if env::var_os("FLATPAK_ID").is_some() {
+        let exec = if app.terminal {
+            format!("cosmic-term -e {exec}")
+        } else {
+            exec
+        };
+        (format!("flatpak-spawn --host {exec}"), false)
+    } else {
+        (exec, app.terminal)
+    };
+    cosmic::desktop::spawn_desktop_exec(
+        exec,
+        Vec::<(String, String)>::new(),
+        Some(app.id.as_str()),
+        terminal,
+    )
+    .await;
+}
