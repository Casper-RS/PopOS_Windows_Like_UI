#!/usr/bin/env python3
"""Remove the password from the GNOME login keyring.

With autologin nothing types your password at login, so the keyring stays
locked and Chrome, VS Code etc. ask for it. This opens the system dialog that
changes the keyring password: type your current password once and leave the
new one empty. Only do this when your disk is encrypted.
"""
import sys

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

BUS = "org.freedesktop.secrets"
COLLECTION = "/org/freedesktop/secrets/collection/login"

bus = Gio.bus_get_sync(Gio.BusType.SESSION)
(prompt,) = bus.call_sync(
    BUS, "/org/freedesktop/secrets",
    "org.gnome.keyring.InternalUnsupportedGuiltRiddenInterface", "ChangeWithPrompt",
    GLib.Variant("(o)", (COLLECTION,)), GLib.VariantType("(o)"),
    Gio.DBusCallFlags.NONE, -1, None,
).unpack()

loop = GLib.MainLoop()
result = {}


def completed(_conn, _sender, _path, _iface, _signal, params):
    result["dismissed"] = params.unpack()[0]
    loop.quit()


bus.signal_subscribe(BUS, "org.freedesktop.Secret.Prompt", "Completed", prompt,
                     None, Gio.DBusSignalFlags.NONE, completed)
bus.call_sync(BUS, prompt, "org.freedesktop.Secret.Prompt", "Prompt",
              GLib.Variant("(s)", ("",)), None, Gio.DBusCallFlags.NONE, -1, None)
print("A dialog is open: enter your current password, leave the new password empty.")
loop.run()

if result.get("dismissed"):
    print("Cancelled; the keyring password is unchanged.")
    sys.exit(1)
print("Done: the login keyring now unlocks without a password.")
